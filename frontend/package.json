{
  "name": "agriculture-client",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "npm run prepare:local && expo start --web",
    "check": "tsc --noEmit && tsx tests/adapters.ts && tsx tests/domain.ts && tsx tests/icons.ts && tsx tests/fineTuned.ts",
    "screenshots": "tsx tests/screenshots.ts",
    "build:web": "npm run prepare:local && expo export --platform web",
    "bundle:native": "expo export --platform android --platform ios --output-dir .cache/native-export",
    "prepare:local": "node scripts/build-workers.mjs && node scripts/build-engine.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@huggingface/transformers": "^4.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.33",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "pyodide": "^314.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
