{
  "name": "agriculture-client",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "check": "tsc --noEmit && tsx tests/adapters.ts && tsx tests/domain.ts",
    "screenshots": "tsx tests/screenshots.ts",
    "build:web": "expo export --platform web",
    "bundle:native": "expo export --platform android --platform ios --output-dir .cache/native-export"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.33",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
