{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "demo",
        "live",
        "cached"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "source"
      ],
      "additionalProperties": true
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "crop": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": true
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "affected_leaf_area_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Optional leaf-level affected area estimate from the image adapter."
          }
        },
        "required": [
          "label",
          "confidence"
        ],
        "additionalProperties": true
      }
    },
    "prior_observations": {
      "type": "array",
      "description": "Optional device-held history near this observation; not stored by the backend.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "condition_id": {
            "type": "string"
          },
          "present": {
            "type": "boolean"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "condition_id",
          "present",
          "latitude",
          "longitude"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "contract_version",
    "id",
    "data_mode",
    "provenance",
    "observed_at",
    "crop",
    "signals"
  ],
  "additionalProperties": true
}
